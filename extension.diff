+package bridge;
+
+// I3: describes a shape as ASCII art text.
+public class AsciiRenderer implements Renderer {
+    @Override
+    public String render(String shapeName, String dimensionName, int dimension) {
+        return "ASCII " + shapeName + " " + dimensionName + "=" + dimension
+                + " art=" + "#".repeat(dimension);
+    }
+}
